{
  "name": "@coze/chat-sdk",
  "version": "0.1.2-beta.1",
  "main": "./dist/lib-source/src/exports/index.js",
  "description": "Coze chat components for taro",
  "author": "gaoding.devingao@bytedance.com",
  "exports": {
    ".": "./dist/lib-source/src/exports/index.js",
    "./webJs": {
      "import": "./dist/lib-h5/exports/index.js",
      "types": "./dist/lib-source/src/exports/index.d.ts"
    },
    "./webCss": "./dist/lib-h5/exports/index.css"
  },
  "types": "./dist/lib-source/src/exports/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "publish:lib": "./scripts/lib-publish.sh",
    "build:lib": "npm run build:taro:source && npm run build:h5:lib",
    "build:taro:source": "rm -rf ./lib-ts && rm -rf ./dist/lib-source/ && ttsc -b tsconfig.build.json && ./scripts/lib-source.sh",
    "build:h5:lib": "cross-env BUILD_DIST=dist/lib-h5 rm -rf ./dist/lib-h5/ && taro build native-components --type h5",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "prepublishOnly": "npm run build:lib",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "build:jd": "taro build --type jd",
    "build:qq": "taro build --type qq",
    "build:quickapp": "taro build --type quickapp",
    "build:rn": "taro build --type rn",
    "build:swan": "taro build --type swan",
    "build:tt": "taro build --type tt",
    "build:weapp": "taro build --type weapp",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:weapp": "npm run build:weapp -- --watch",
    "test": "jest"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@coze/api": "1.0.15",
    "@rsbuild/plugin-react": "^1.1.0",
    "@tarojs/components": "4.0.8",
    "@tarojs/helper": "4.0.8",
    "@tarojs/plugin-framework-react": "4.0.8",
    "@tarojs/plugin-http": "^4.0.8",
    "@tarojs/plugin-platform-alipay": "4.0.8",
    "@tarojs/plugin-platform-h5": "4.0.8",
    "@tarojs/plugin-platform-harmony-hybrid": "4.0.8",
    "@tarojs/plugin-platform-jd": "4.0.8",
    "@tarojs/plugin-platform-qq": "4.0.8",
    "@tarojs/plugin-platform-swan": "4.0.8",
    "@tarojs/plugin-platform-tt": "4.0.8",
    "@tarojs/plugin-platform-weapp": "4.0.8",
    "@tarojs/react": "4.0.8",
    "@tarojs/runtime": "4.0.8",
    "@tarojs/shared": "4.0.8",
    "@tarojs/taro": "4.0.8",
    "classnames": "^2.3.2",
    "core-js": "^3.39.0",
    "lodash-es": "^4.17.21",
    "mdast": "3.0.0-alpha.6",
    "mdast-util-from-markdown": "2.0.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "showdown": "~2.1.0",
    "tsconfig-paths": "^4.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/plugin-transform-unicode-property-regex": "^7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@rsbuild/plugin-less": "^1.1.0",
    "@tarojs/cli": "4.0.8",
    "@tarojs/plugin-http": "^4.0.8",
    "@tarojs/taro-loader": "4.0.8",
    "@tarojs/webpack5-runner": "4.0.8",
    "@types/mdast": "4.0.3",
    "@types/node": "^18",
    "@types/react": "18.2.37",
    "@types/showdown": "^2.0.6",
    "@types/webpack-env": "^1.13.6",
    "babel-loader": "~9.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-taro": "4.0.8",
    "cross-env": "^7.0.3",
    "dts": "^0.1.1",
    "postcss": "^8.4.32",
    "react-refresh": "0.14.0",
    "ts-node": "^10.9.1",
    "ts-patch": "^3.3.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "ttsc": "^0.3.1",
    "typescript": "^4.9.5",
    "typescript-transform-paths": "^3.5.2",
    "webpack": "5.91.0"
  },
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Less",
    "framework": "React"
  }
}
